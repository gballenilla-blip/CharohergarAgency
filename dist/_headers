# Cabeceras para Cloudflare Pages (archivo especial: se lee solo en Pages)
# Seguridad básica + caché agresiva para assets, corta para el HTML.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# El HTML cambia con cada despliegue: nunca cachearlo.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Assets versionados por contenido (fotos/vídeos): caché larga.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
